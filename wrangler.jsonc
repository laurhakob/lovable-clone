// Cloudflare Workers config for the Next.js frontend (built with OpenNext).
// The API worker has its own config in worker/wrangler.jsonc.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lovable-clone-web",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
